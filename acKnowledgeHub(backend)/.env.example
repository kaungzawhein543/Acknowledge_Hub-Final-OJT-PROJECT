# Copy this file to .env, replace every required value, then export it:
# set -a; source .env; set +a

# Required secrets
# Prefer 64+ characters. Shorter values are SHA-512 hashed so HS512 still accepts them.
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-64-bytes
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
TELEGRAM_BOT_NAME=your-bot-name
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_ENABLED=false
DEFAULT_USER_PASSWORD=acknowledgeHub
DEFAULT_ADMIN_PASSWORD=adminPassword

# Deployment URLs
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
TELEGRAM_BOT_URL=https://t.me/your-bot-name

# Optional database overrides (H2 defaults are used when omitted)
DB_USERNAME=sa
DB_PASSWORD=
H2_CONSOLE_ENABLED=true

# Optional seed account overrides
SEED_ADMIN_STAFF_ID=ADMIN001
SEED_ADMIN_EMAIL=admin@example.com
SEED_USER_STAFF_ID=EMP001
SEED_USER_EMAIL=user@example.com
